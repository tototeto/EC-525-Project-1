pacman::p_load(tidyverse, magrittr, tableone, stargazer, fixest, sandwich, modelsummary, gtsummary)
ohp <- read.csv("ohp.csv")
# Balance Table
pre_survey_vars <- c("age_inp",
"dep_dx_pre_lottery",
"dia_dx_pre_lottery",
"edu_inp",
"hbp_dx_pre_lottery",
"hispanic_inp",
"numhh_list",
"race_black_inp",
"race_white_inp",
"ohp_all_ever_survey")
models <- lapply(pre_survey_vars, function(var) {
feols(as.formula(paste(var, "~ treatment")), data = ohp, vcov = "hetero")
})
names(models) <- pre_survey_vars
modelsummary(models,
output = "html",
title = "Balance Table: Covariates by Treatment Status"
)
ohp %>%
select(treatment, all_of(pre_survey_vars)) %>%
tbl_summary(by = treatment, statistic = all_continuous() ~ "{mean} ({sd})") %>%
add_p(test = all_continuous() ~ "t.test") %>%
modify_header(label ~ "**Variable**") %>%
bold_labels()
modelsummary(models,
output = "html",
title = "Balance Table: Covariates by Treatment Status"
)
View(models)
modelsummary(models,
output = "html",
title = "Balance Table: Covariates by Treatment Status",
shape = term ~ model
)
modelsummary(models,
output = "html",
title = "Balance Table: Covariates by Treatment Status",
shape = model ~ term
)
modelsummary(models,
output = "html",
title = "Balance Table: Covariates by Treatment Status",
shape = model ~ term ,
stars = TRUE
)
modelsummary(models,
output = "html",
title = "Balance Table: Covariates by Treatment Status",
shape = model ~ term ,
stars = TRUE,
coef_rename = c("treat" = "Treatment vs Control")
)
modelsummary(models,
output = "html",
title = "Balance Table: Covariates by Treatment Status",
shape = model ~ term ,
stars = TRUE
)
