View(ohp)
lm(data = ohp, ohp_all_ever_survey ~ treatment)
comp <- lm(data = ohp, ohp_all_ever_survey ~ treatment)
se_comp <- sqrt(diag(vcovHC(comp)))
stargazer(
comp,
se = se_comp,
type = 'html'
)
