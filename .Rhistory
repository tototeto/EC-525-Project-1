pacman::p_load(tidyverse, magrittr, tableone, stargazer, fixest, sandwhich, modelsummary)
ohp <- read.csv("ohp.csv")
# Balance Table
pre_survey_vars <- c("age_inp",
"dep_dx_pre_lottery",
"dia_dx_pre_lottery",
"edu_inp",
"hbp_dx_pre_lottery",
"hispanic_inp",
"numhh_list",
"race_black_inp",
"race_white_inp",
"ohp_all_ever_survey")
models <- lapply(pre_survey_vars, function(var) {
feols(as.formula(paste(var, "~ treatment")), data = ohp, vcov = "hetero")
})
names(models) <- pre_survey_vars
modelsummary(models,
estimate = "{estimate} ({std.error})",
statistic = NULL,
gof_omit = ".*",
output = "html",
title = "Balance Table: Covariates by Treatment Status"
)
modelsummary(models,
estimate = "{estimate} ({std.error})",
output = "html",
title = "Balance Table: Covariates by Treatment Status"
)
modelsummary(models,
output = "html",
title = "Balance Table: Covariates by Treatment Status"
)
pacman::p_load(tidyverse, magrittr, tableone, stargazer, fixest, sandwhich, modelsummary, gtsummary)
ohp %>%
select(treat, all_of(pre_survey_vars)) %>%
tbl_summary(by = treat, statistic = all_continuous() ~ "{mean} ({sd})") %>%
add_p(test = all_continuous() ~ "t.test") %>%
modify_header(label ~ "**Variable**") %>%
bold_labels()
ohp %>%
select(treat, all_of(pre_survey_vars)) %>%
tbl_summary(by = treatment, statistic = all_continuous() ~ "{mean} ({sd})") %>%
add_p(test = all_continuous() ~ "t.test") %>%
modify_header(label ~ "**Variable**") %>%
bold_labels()
ohp %>%
select(treat, all_of(pre_survey_vars)) %>%
tbl_summary(by = treatment, statistic = all_continuous() ~ "{mean} ({sd})") %>%
add_p(test = all_continuous() ~ "t.test") %>%
modify_header(label ~ "**Variable**") %>%
bold_labels()
ohp %>%
select(treatment, all_of(pre_survey_vars)) %>%
tbl_summary(by = treatment, statistic = all_continuous() ~ "{mean} ({sd})") %>%
add_p(test = all_continuous() ~ "t.test") %>%
modify_header(label ~ "**Variable**") %>%
bold_labels()
