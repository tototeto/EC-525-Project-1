pacman::p_load(tidyverse, magrittr, tableone)
pre_survey_vars <- c("age_inp",
"dep_dx_pre_lottery",
"dia_dx_pre_lottery",
"edu_inp",
"hbp_dx_pre_lottery",
"hispanic_inp",
"numhh_list",
"race_black_inp",
"race_white_inp",
"ohp_all_ever_survey")
balance_table <- CreateTableOne(vars = pre_survey_vars, strata = "treatment", data = ohp)
print(balance_table)
pacman::p_load(tidyverse, magrittr, tableone, stargazer)
table_matrix <- as.matrix(print(balance_table, quote = FALSE, noSpaces = TRUE))
stargazer(table_matrix, type = "html", out = "balance_table.html")
