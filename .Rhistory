health_outcomes <- c(
"dep_dx_post_lottery",
"dia_dx_post_lottery",
"doc_num_mod_inp",
"hbp_dx_post_lottery",
"bp_sar_inp"
)
models_itt <- lapply(health_outcomes, function(var) {
feols(as.formula(paste(var, "~ treatment")), data = ohp, vcov = "hetero")
})
modelsummary(
models_itt,
title = "ITT Effects",
output = "gt",  # changed to gt for compatibility
shape = model ~ term,
stars = TRUE
)
itt_system <- list(models_itt)
View(itt_system)
itt_system <- as.list(models_itt)
View(itt_system)
pacman::p_load(tidyverse, magrittr, tableone, stargazer, fixest, sandwich, modelsummary, gtsummary, systemfit)
itt_system <- as.list(models_itt)
itt_system %<>% systemfit(data = ohp, method = "SUR")
itt_system %<>% lapply(formula)
itt_system %<>% systemfit(data = ohp, method = "SUR")
linearHypothesis(itt_system, c("eq1_DIS = eq2_DIS"))
