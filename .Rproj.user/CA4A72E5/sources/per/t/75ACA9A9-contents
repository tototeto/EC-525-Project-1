# Balance Table

```{r balance_table, echo=FALSE, warning=FALSE, results='asis', cache=TRUE}
pacman::p_load(tidyverse, magrittr, tableone, stargazer, fixest, sandwich, modelsummary, gtsummary, systemfit)

ohp <- read.csv("ohp.csv")

# Balance Table
pre_survey_vars <- c(
  "age_inp", 
  "dep_dx_pre_lottery", 
  "dia_dx_pre_lottery",
  "edu_inp",
  "hbp_dx_pre_lottery",
  "hispanic_inp",
  "numhh_list",
  "race_black_inp",
  "race_white_inp"
)

models <- lapply(pre_survey_vars, function(var) {
  feols(as.formula(paste(var, "~ treatment")), data = ohp, vcov = "hetero")
})
names(models) <- pre_survey_vars

modelsummary(
  models,
  title = "Balance Table",
  output = "gt",  # changed to gt for compatibility
  shape = model ~ term,
  stars = TRUE
)

```


# Compliance 
```{r compliance, echo=FALSE, warning=FALSE, results='asis', cache=TRUE}
comp <- lm(data = ohp, ohp_all_ever_survey ~ treatment)
se_comp <- sqrt(diag(vcovHC(comp)))

stargazer(
  comp,
  se = list(se_comp),
  type = "html"
)

```

Treatment has an effect significant at the 1% level. Medicaid enrollment increases by 25pp in the treated group compared to the control group.

# ITT Effect

```{r itt,  echo=FALSE, warning=FALSE, results='asis', cache=TRUE}
health_outcomes <- c(
  "dep_dx_post_lottery",
  "dia_dx_post_lottery",
  "doc_num_mod_inp",
  "hbp_dx_post_lottery",
  "bp_sar_inp"
)

models_itt <- lapply(health_outcomes, function(var) {
  feols(as.formula(paste(var, "~ treatment")), data = ohp, vcov = "hetero")
})

names(models_itt) <- c("Depression Dx", "Diabetes Dx", "Doctors Visits", "High BP Dx", "BP Average")

modelsummary(
  models_itt,
  title = "ITT Effects",
  output = "gt",  # changed to gt for compatibility
  shape = term ~ model,
  stars = TRUE
)
```

